#!/usr/bin/env bash
#MISE description="Build SolarExpanseLaunchWindows.dll and install to game (requires SOLAR_EXPANSE_ROOT)"
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"

configuration="${CONFIGURATION:-Release}"

if ! command -v dotnet >/dev/null 2>&1; then
  echo "error: dotnet is required. Run: mise install" >&2
  exit 1
fi

dotnet build "$repo_root/src/mod" -c "$configuration" --nologo --verbosity quiet
